{
  "name": "baseline",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/seed-dashboard-data.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/seed-dashboard-data.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "mock": "python mock/mockgen.py --out mock/mock_events.db",
    "data": "python -m engine.export",
    "dev:live": "node scripts/dev-live.mjs",
    "collect:install": "pip install git+https://github.com/Proj-Baseline/baseline-collector",
    "collect": "python -m collector run",
    "collect:doctor": "python -m collector doctor",
    "collect:status": "python -m collector status",
    "data:real": "python -m engine.export --db ~/.baseline/events.db --source real",
    "data:watch": "python -m engine.watch --db ~/.baseline/events.db --source real",
    "test:py": "python -m pytest tests -q",
    "typecheck:py": "python -m mypy engine"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
