# Copy to .env.local and fill in. See docs/EMAIL_CAPTURE.md.
#
# Server-only on purpose — no NEXT_PUBLIC_ prefix. The signup POST is made by
# the `submitSignup` server action, not the browser, so the endpoint never
# reaches the client bundle.

# Apps Script web app deployment URL. Without it the form reports that signup
# isn't wired up rather than pretending to save.
SIGNUP_ENDPOINT=https://script.google.com/macros/s/.../exec

# Optional shared secret, sent as `secret` in the request body. Only has any
# effect once the matching check exists in the Apps Script.
SIGNUP_SHARED_SECRET=
